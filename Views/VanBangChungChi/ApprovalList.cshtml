@model IEnumerable<HeThongVanBangSo.Models.VanBangChungChi>

@{
    ViewData["Title"] = "Duyệt Cấp Phát Văn Bằng";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary">Duyệt Cấp Phát Văn Bằng</h2>
    <button id="btnBatchApprove" class="btn btn-success">
        <i class="bi bi-pen"></i> Ký Duyệt & Phát Hành
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 50px;">
                            <input type="checkbox" id="selectAll" class="form-check-input" />
                        </th>
                        <th>Mã VB (Số hiệu)</th>
                        <th>Tên Người Nhận</th>
                        <th>Tên Văn Bằng</th>
                        <th>Đơn vị Phát Hành</th>
                        <th>Ngày Cấp</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input cb-item" value="@item.MaVanBang" />
                                </td>
                                <td><strong>@item.SoHieu</strong></td>
                                <td>
                                    @item.NguoiNhan?.HoTen <br />
                                    <small class="text-muted">CCCD: @item.NguoiNhan?.SoCCCD</small>
                                </td>
                                <td>@item.TenVanBang</td>
                                <td>@item.DonViPhatHanh?.TenDonVi</td>
                                <td>@item.NgayCap.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Không có văn bằng nào đang chờ duyệt.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('selectAll');
            const checkboxes = document.querySelectorAll('.cb-item');
            const btnBatchApprove = document.getElementById('btnBatchApprove');

            // Xử lý Check All
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(cb => cb.checked = selectAll.checked);
                });
            }

            // Xử lý Checkbox con (nếu bỏ chọn 1 cái thì bỏ Check All)
            checkboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    if (!this.checked) {
                        selectAll.checked = false;
                    }
                    // Nếu tất cả đều checked, check cái selectAll
                    else if (document.querySelectorAll('.cb-item:checked').length === checkboxes.length) {
                        selectAll.checked = true;
                    }
                });
            });

            // Xử lý nút Ký Duyệt & Phát Hành
            if (btnBatchApprove) {
                btnBatchApprove.addEventListener('click', function () {
                    const selected = document.querySelectorAll('.cb-item:checked');
                    if (selected.length === 0) {
                        alert('Vui lòng chọn ít nhất một văn bằng để duyệt.');
                        return;
                    }

                    if (!confirm(`Bạn có chắc chắn muốn ký duyệt và phát hành ${selected.length} văn bằng đã chọn?`)) {
                        return;
                    }

                    const selectedIds = Array.from(selected).map(cb => parseInt(cb.value));
                    
                    // Lấy token chống CSRF
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    // Disable nút, hiện loading
                    const originalBtnText = btnBatchApprove.innerHTML;
                    btnBatchApprove.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';
                    btnBatchApprove.disabled = true;

                    fetch('/VanBangChungChi/BatchApproveAndSign', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(selectedIds)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            window.location.reload(); // Load lại trang
                        } else {
                            alert('Lỗi: ' + data.message);
                            btnBatchApprove.innerHTML = originalBtnText;
                            btnBatchApprove.disabled = false;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Có lỗi hệ thống xảy ra khi xử lý.');
                        btnBatchApprove.innerHTML = originalBtnText;
                        btnBatchApprove.disabled = false;
                    });
                });
            }
        });
    </script>
}
