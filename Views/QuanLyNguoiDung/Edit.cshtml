@model HeThongVanBangSo.Models.NguoiDung

@{
    ViewData["Title"] = "Sửa Tài Khoản";
    var roles = ViewBag.Roles as List<string>;
    var currentRole = ViewBag.CurrentRole as string;
    var donViList = ViewBag.DanhSachDonVi as List<HeThongVanBangSo.Models.DonViPhatHanh>;
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="text-primary">Sửa Tài Khoản: @Model.HoTen</h3>
            <a href="/QuanLyNguoiDung" class="btn btn-outline-secondary btn-sm">← Quay lại</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <form method="post" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="hoTen" class="form-label fw-semibold">Họ và Tên</label>
                        <input type="text" id="hoTen" name="hoTen" class="form-control" value="@Model.HoTen" required />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Email</label>
                        <input type="email" id="email" name="email" class="form-control" value="@Model.Email" required />
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label fw-semibold">Vai Trò</label>
                        <select id="role" name="role" class="form-select" required>
                            @if (roles != null)
                            {
                                foreach (var r in roles)
                                {
                                    string displayName = r switch
                                    {
                                        "Admin" => "Admin (Toàn quyền)",
                                        "NhanVien" => "Nhân Viên (Quản lý VB, Ký duyệt)",
                                        "ChuVanBang" => "Chủ Văn Bằng (Xin cấp phát)",
                                        _ => r
                                    };
                                    <option value="@r" selected="@(r == currentRole)">@displayName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="maDonVi" class="form-label fw-semibold">Đơn Vị</label>
                        <select id="maDonVi" name="maDonVi" class="form-select">
                            <option value="">— Không gắn đơn vị —</option>
                            @if (donViList != null)
                            {
                                foreach (var dv in donViList)
                                {
                                    <option value="@dv.MaDonVi" selected="@(Model.MaDonVi == dv.MaDonVi)">@dv.TenDonVi (@dv.MaCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="newPassword" class="form-label fw-semibold">Mật khẩu mới (để trống nếu không đổi)</label>
                        <input type="password" id="newPassword" name="newPassword" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-semibold">Cập Nhật</button>
                </form>
            </div>
        </div>
    </div>
</div>
