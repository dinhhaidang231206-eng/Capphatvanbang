@model IEnumerable<HeThongVanBangSo.Models.YeuCauCapPhat>

@{
    ViewData["Title"] = "Lịch Sử Yêu Cầu Cấp Phát";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary">Lịch Sử Xin Cấp Phát Văn Bằng</h2>
    <a href="/YeuCauCapPhat/Create" class="btn btn-success">+ Gửi Yêu Cầu Mới</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Tên Văn Bằng</th>
                        <th>Đơn Vị Phát Hành</th>
                        <th>Người Yêu Cầu</th>
                        <th>Số CCCD</th>
                        <th>Ngày Yêu Cầu</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.TenVanBang</strong></td>
                                <td>@(item.DonViPhatHanh?.TenDonVi ?? "—")</td>
                                <td>@item.HoTen<br/><small class="text-muted">NS: @item.NgaySinh.ToString("dd/MM/yyyy")</small></td>
                                <td>@item.SoCCCD</td>
                                <td>@item.NgayYeuCau.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.TrangThai == "CHO_DUYET")
                                    {
                                        <span class="badge bg-warning text-dark">Chờ Duyệt</span>
                                    }
                                    else if (item.TrangThai == "DA_DUYET")
                                    {
                                        <span class="badge bg-success">Đã Duyệt</span>
                                    }
                                    else if (item.TrangThai == "TU_CHOI")
                                    {
                                        <span class="badge bg-danger">Từ Chối</span>
                                        <br/><small class="text-danger">@item.LyDoTuChoi</small>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Bạn chưa gửi yêu cầu xin cấp phát nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
